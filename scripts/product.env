# Product name, bundle id and repository in one place, for the build, release and packaging scripts
# and the workflows (`. scripts/product.env`). The cask and the README spell them out; change them there too.
PRODUCT_NAME='Baton'
# Kept from before the rename: macOS, existing installs and the one-copy check know the app by it.
BUNDLE_ID='io.github.trukhinyuri.claudeprofiles'
REPO_SLUG='trukhinyuri/Baton'
ARCHIVE_STEM='Baton'
# The Homebrew tap and cask; packaging/homebrew/Casks holds the cask's source.
TAP_SLUG='trukhinyuri/homebrew-tap'
CASK_TOKEN='baton'
